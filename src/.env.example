# Copier ce fichier en .env puis renseigner les valeurs :
#   copy src\.env.example src\.env

# Compte expéditeur des alertes.
# Pour Gmail : utiliser un "mot de passe d'application" (validation en 2 étapes requise),
# jamais le mot de passe principal du compte.
SMTP_EMAIL=votre.adresse@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Destinataire des rapports d'alerte
ALERT_RECIPIENT=analyste@exemple.com